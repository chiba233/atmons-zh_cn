	task.5F45BABFD89DE0EC.title: "版权所有"
	task.614C3310C61487CB.title: "难得素奥术师盔甲"
	task.61E3800DF5D25567.title: "ATM奥术师盔甲"
	task.6304FF8A9E8957FE.title: "难得素工具"
	task.6514595CBD4DE6C6.title: "前往彼岸"
	task.681CB7DF06F2F506.title: "前往挖矿维度"
	task.6AE0DA6AB109A840.title: "开山采石"
	task.6C974DF242CFDB8E.title: "定位一座远古金字塔"
	task.7A588081117FA54F.title: "版权所有"
	quest.24934231538B6492.quest_desc: [
		"远古金字塔是&b&l彼岸&r三大结构之一。\\n\\n它显然是座金字塔，而且这一座没有地下室！\\n\\n取而代之的是&e猪巫丘&r！\\n\\n没听错，这里已经不是&e猪巫妖&r了，它们变成了一种叫&e猪巫丘&r的&c宝可梦&r。\\n\\n和别的&c宝可梦&r一样，你可以跟它们对战、把它们收服！\\n"
		"{image:atm:textures/questpics/allthemodium/all_pyramid.png width:200 height:100 align:center}"
	]
}
