{
	quest.0061B0577B1C4AEF.quest_desc: [
		"&7我们的&b末影接口&7之旅，从找一种会发光的奇怪材料开始。"
		"&6无限粉&r要靠&c点燃&r&7基岩&r来拿：点燃一块基岩，有小概率让它掉出这东西。"
		"&a提示：&r起步只要一小把就够——末影接口几乎每一条基础配方都从它开始，包括最朴素的&6合金炉&r。"
	]
	quest.0061B0577B1C4AEF.quest_subtitle: "&7基岩之力的一点火星"
	quest.0061B0577B1C4AEF.title: "&d&l无限粉"
	quest.00E6B3F670E20454.quest_desc: [
		"&7&l魂金&r由&6金&r和&7灵魂沙&r在&6合金炉&r里锻成。"
		"&5灵魂瓶&r，以及所有跟捕捉、绑定灵魂有关的机器（比如&5灵魂绑定器&r），背后都是它。"
	]
	quest.00E6B3F670E20454.quest_subtitle: "&7被受难灵魂缠住的金"
	quest.00E6B3F670E20454.title: "&5&l魂金锭"
	quest.03EC3173343B11F5.quest_desc: [
		"&7用&7玄钢锭&r打造。它之后还能装特殊模块继续强化，比如提高伤害或多开附魔槽。"
		"&a提示：&r解锁强化项之后，潜行右键就能打开它的升级界面。"
	]
	quest.03EC3173343B11F5.quest_subtitle: "&7会跟着我们一起成长的剑"
	quest.03EC3173343B11F5.title: "&7&l终结之剑"
	quest.0527CE6921ADB079.quest_desc: [
		"&7&5灵魂绑定器&r消耗&9µI&r和经验汁来合成特殊物品，比如把装满的&5灵魂瓶&r绑到&7破损的刷怪笼&r上。"
		"给它充经验有两条路：用&7经验棒&r，或者用流体导管把&2经验汁&r送进去。"
	]
	quest.0527CE6921ADB079.quest_subtitle: "&7能量与液态经验交汇之处"
	quest.0527CE6921ADB079.title: "&5&l灵魂绑定器"
	quest.05352452468E8375.quest_desc: [
		"&7&b导电合金&r在&6合金炉&r里由&6金&r、&c红石&r和&e荧石粉&r锻成。"
		"我们用它做高级能量导管，还有几种磨珠和中期机器。"
	]
	quest.05352452468E8375.quest_subtitle: "&7金、红石与荧石的合成物"
	quest.05352452468E8375.title: "&b&l导电合金锭"
	quest.082DEC8CBA6D23E5.quest_desc: [
		"&7&l玄钢&r是末影接口里最重要的合金之一。"
		"在&6合金炉&r里把&f铁&r、&8煤粉&r和&5黑曜石&r合到一起就能做出来。"
		"&a提示：&r玄钢工具、玄钢护甲和好几台高级机器都靠它，手头常备一些为好。"
	]
	quest.082DEC8CBA6D23E5.quest_subtitle: "&7由铁、煤与黑曜石锻成"
	quest.082DEC8CBA6D23E5.title: "&7&l玄钢锭"
	quest.0C220E9B2A780082.quest_desc: [
		"&7把电池升级成&b高级电容库&r，既能装更多能量，给工具充电也更快。"
		"它由&b基础电容库&r和&a双层电容&r搭成。"
	]
	quest.0C220E9B2A780082.quest_subtitle: "&7缓存更大，充电更快"
	quest.0C220E9B2A780082.title: "&b&l高级电容库"
	quest.0EAB51C9B13A959B.quest_desc: [
		"&7只要站在附近，&9无线充能器&r就会给我们手上、身上任何由 RF 供电的工具、护甲和物品充电。"
		"不用手动插线，靠电容供电的装备就一直是满的，省事。"
	]
	quest.0EAB51C9B13A959B.quest_subtitle: "&7不用接线就能充电"
	quest.0EAB51C9B13A959B.title: "&9&l无线充能器"
	quest.128E4A78E76F366C.quest_desc: [
		"&7先弄一个&7破损的刷怪笼&r，再把装着目标生物的&5灵魂瓶&r和它一起放进&5灵魂绑定器&r，把那个灵魂绑上去。"
		"再跟&c电动刷怪笼&r的外壳合到一起，就得到一台能正常刷那种生物的刷怪笼——靠&9µI&r驱动，不再需要旁边站个玩家。"
		"&e注意：&r这条任务用的是&f悦灵&r，但几乎任何生物都能用灵魂瓶抓。"
	]
	quest.128E4A78E76F366C.quest_subtitle: "&7让任何刷怪笼听我们的"
	quest.128E4A78E76F366C.title: "&c&l电动刷怪笼"
	quest.141101C9A381905C.quest_desc: [
		"&7末影接口的机器&l几乎每一台&r都要装上电容，才能存和用&9µI&r。"
		"&a基础电容&r是起步的那一档，由&e充能合金&r做成。不装电容，机器根本不会启动。"
	]
	quest.141101C9A381905C.quest_subtitle: "&7每台机器的心脏"
	quest.141101C9A381905C.title: "&a&l基础电容"
	quest.19456F38224A24DB.quest_desc: [
		"&7&8半自磨机&r用&9µI&r把矿石和别的东西磨成碎块或粉末，产出往往比直接烧炼或合成更多。"
		"在它的升级槽里放&7磨珠&r，可以提升速度、效率，甚至提高翻倍产出的概率。"
		"&a提示：&r长期算下来，粗矿拿来磨比直接烧，每块矿能出更多锭。"
	]
	quest.19456F38224A24DB.quest_subtitle: "&7把矿石磨出额外的收成"
	quest.19456F38224A24DB.title: "&8&l半自磨机"
	quest.1AF97F48B4C13020.quest_desc: [
		"&7&6耶塔扳手&r是操作末影接口方块的主力工具：右键转向机器，潜行右键把它捡起来，里面的物品和升级都不会丢。"
		"配置&b导管&r也少不了它——设定各面的输入输出和颜色，物品、能量、流体才会准确流到我们想要的地方。"
	]
	quest.1AF97F48B4C13020.quest_subtitle: "&7机器与导管的万用工具"
	quest.1AF97F48B4C13020.title: "&6&l耶塔扳手&r &f与 &2&l导管"
	quest.1D0725DC4463F895.quest_desc: [
		"&7只要通过导管或漏斗把材料送进去，&f合成器&r就会一直按我们设定的配方自动合成。"
		"它是自动化工厂的骨干，从此再也不用手点工作台。"
	]
	quest.1D0725DC4463F895.quest_subtitle: "&7把工作台自动化"
	quest.1D0725DC4463F895.title: "&f&l合成器"
	quest.224BF0C9690FBEBF.quest_desc: [
		"&7&5附魔器&r用&9µI&r把&d附魔书&r附到装备上，不走铁砧，也没有铁砧那套等级惩罚。"
		"给玄钢或末影系的工具武器叠附魔时尤其好用。"
	]
	quest.224BF0C9690FBEBF.quest_subtitle: "&7用能量把附魔书附上去"
	quest.224BF0C9690FBEBF.title: "&5&l附魔器"
	quest.262B331BB96336F5.quest_desc: [
		"&7基地里&b导管&r一多就乱。&f导管伪装方块&r能把任意一束导管伪装成我们挑的任何方块。"
		"&a提示：&r直接把它放到导管上就行，外观融进建筑，底下照常工作。"
	]
	quest.262B331BB96336F5.quest_subtitle: "&7把导管藏在明处"
	quest.262B331BB96336F5.title: "&f&l导管伪装方块"
	quest.2802D606849ED924.quest_desc: [
		"&7&6喷涂机&r自动给方块套上伪装材质，成批换皮，不用一个个手放。"
		"&a提示：&r把要伪装的方块和想让它变成的样子一起丢进去，它会把整组都处理完。"
	]
	quest.2802D606849ED924.quest_subtitle: "&7成批给方块换皮"
	quest.2802D606849ED924.title: "&6&l喷涂机"
	quest.2AD8903E9EE3269E.quest_desc: [
		"&7&5灵魂链条&r由&5魂金&r制成，是灵魂系机器和装备的组件。"
		"它代表末影接口配方树上更神秘、更末影味的那一支。"
	]
	quest.2AD8903E9EE3269E.quest_subtitle: "&7由魂金锻成"
	quest.2AD8903E9EE3269E.title: "&5&l灵魂链条"
	quest.2C7D1CD63680FA80.quest_desc: [
		"&7&2头颅装配机&r能把两件附魔物品合成一件，像原版铁砧那样合并附魔，只是改用&9µI&r驱动。"
		"它还能修工具和护甲，而且不需要对应材料，长期能省下不少资源。"
	]
	quest.2C7D1CD63680FA80.quest_subtitle: "&7合并附魔，顺带修装备"
	quest.2C7D1CD63680FA80.title: "&2&l头颅装配机"
	quest.32191922242B11B5.quest_desc: [
		"&7&5注魂框架&r是拿&5灵魂链条&r把基础的&8虚空框架&r升级来的，给它添了一点束魂的法力。"
		"末影接口里更高级的灵魂系机器都要用它，我们的末影之旅也就此更深一层。"
	]
	quest.32191922242B11B5.quest_subtitle: "&7绑着灵魂的框架"
	quest.32191922242B11B5.title: "&5&l注魂框架"
	quest.3294189EF3C0D5E5.quest_desc: [
		"&7只要经验够付路费，&d旅行权杖&r就能让我们在世界各处放好的&d旅行锚&r之间瞬间传送。"
		"基地和每个远方据点都放一个&d旅行锚&r，出门探索和回家都省心。"
	]
	quest.3294189EF3C0D5E5.quest_subtitle: "&7在旅行锚之间来回传送"
	quest.3294189EF3C0D5E5.title: "&d&l旅行权杖"
	quest.3DBAC2CDD75763F3.quest_desc: [
		"&7&9电磁铁&r由&b导电合金&r和&e充能合金&r制成。"
		"它主要当组件用，出现在末影接口那些需要吸附或处理金属材料的高级机器和物品的配方里。"
	]
	quest.3DBAC2CDD75763F3.quest_subtitle: "&7隔着一段距离把金属吸过来"
	quest.3DBAC2CDD75763F3.title: "&9&l电磁铁"
	quest.402A53010DFB2D69.quest_desc: [
		"&7&6斯特林发电机&r烧煤、木炭这类固体燃料，给我们的机器发&9µI&r。"
		"简单可靠。在换上更大的发电机之前，用它把第一套末影接口设施带起来正合适。"
	]
	quest.402A53010DFB2D69.quest_subtitle: "&7我们的第一台电源"
	quest.402A53010DFB2D69.title: "&6&l斯特林发电机"
	quest.435B180FCE208A7B.quest_desc: [
		"&7换上&a双层电容&r，机器的储能更多，处理速度也更快。"
		"它用&e充能合金&r加一个&a基础电容&r合成；发电量上来之后，很自然就该换它了。"
	]
	quest.435B180FCE208A7B.quest_subtitle: "&7能量更多，速度更快"
	quest.435B180FCE208A7B.title: "&a&l双层电容"
	quest.448CCD89539AEBAC.quest_desc: [
		"&7&9有线充能器&r通过导管直接接进能量网，给放进它里面的任何由 RF 供电的物品充电。"
		"想把工具丢着充、人去干别的时，它和无线充能器正好配一对。"
	]
	quest.448CCD89539AEBAC.quest_subtitle: "&7把装备直接插上去"
	quest.448CCD89539AEBAC.title: "&9&l有线充能器"
	quest.4557E63F1A6971DA.quest_desc: [
		"&7&b振动电容库&r是储能的最后一档，能存下海量&9µI&r。"
		"造它要一个&b高级电容库&r和&a八位电容&r，适合当电网的长期目标。"
	]
	quest.4557E63F1A6971DA.quest_subtitle: "&7终极储能"
	quest.4557E63F1A6971DA.title: "&b&l振动电容库"
	quest.477F0905998597FE.quest_desc: [
		"&7&b汲液泵&r会自动把附近生物产出的流体（比如牛奶）收进接着的储罐里。"
		"不用一只只手动去挤，流体采集就自动化了。"
	]
	quest.477F0905998597FE.quest_subtitle: "&7从附近生物身上榨出流体"
	quest.477F0905998597FE.title: "&b&l汲液泵"
	quest.47F7BA8E81383714.quest_desc: [
		"&7&d末影水晶&r在&5灵魂绑定器&r里做：用一个装着&d末影人&r的&5灵魂瓶&r。"
		"末影接口最高级的一些物品都要用它，跟这个模组的末影魔法一脉相承。"
	]
	quest.47F7BA8E81383714.quest_subtitle: "&7末地结晶出的碎片"
	quest.47F7BA8E81383714.title: "&d&l末影水晶"
	quest.490B64C64BDE76F7.quest_desc: [
		"&7&8虚空框架&r是末影接口早中期大多数机器的基础框架，从发电机到加工机都用它。"
		"基地一扩就得做不少个，值得先囤一批&6玄钢锭&r。"
	]
	quest.490B64C64BDE76F7.quest_subtitle: "&7机器背后的那副骨架"
	quest.490B64C64BDE76F7.title: "&8&l虚空框架"
	quest.4A7DBDB179F30BC3.quest_desc: [
		"&7&e充能合金&r在&6合金炉&r里由&c红石&r、&e荧石粉&r和&6金&r合成。"
		"它是&6电容&r的基础材料，为了让机器一直有电，这东西要做很多。"
	]
	quest.4A7DBDB179F30BC3.quest_subtitle: "&7红石、荧石与金"
	quest.4A7DBDB179F30BC3.title: "&e&l充能合金锭"
	quest.5D327D85B91E5032.quest_desc: [
		"&7手里有了&d无限粉&7，终于可以造&6合金炉&r了——末影接口前期进程的核心。"
		"这台机器用的是&9µI&r，末影接口自己的那套能量。它既能像熔炉一样烧矿，也能锻出玄钢之类的特殊&6合金&r。"
		"&e注意：&r至少要装一个&6基础电容&r它才会启动，别忘了这一件！"
	]
	quest.5D327D85B91E5032.quest_subtitle: "&7我们真正意义上的第一台机器"
	quest.5D327D85B91E5032.title: "&6&l合金炉"
	quest.60A8F55648685236.quest_desc: [
		"&7&a八位电容&r是我们能做出的最强电容，由&d振动合金&r加一个&a双层电容&r合成。"
		"装上它的机器速度和储能都拉满，正适合后期的建设。"
	]
	quest.60A8F55648685236.quest_subtitle: "&7最好的那一档电容"
	quest.60A8F55648685236.title: "&a&l八位电容"
	quest.62788B8B97AF2D76.quest_desc: [
		"&7在&6合金炉&r里把&e充能合金&r和&d末影珍珠&r合到一起，就得到&d振动合金&r。"
		"最好的电容和好几台后期机器都靠这种合金，多花几颗末影珍珠很值。"
	]
	quest.62788B8B97AF2D76.quest_subtitle: "&7被末影魔法点过的充能合金"
	quest.62788B8B97AF2D76.title: "&d&l振动合金锭"
	quest.6B37B24E3D25BF5C.quest_desc: [
		"&7&2酿液桶&r会把末影水晶粉这类有机材料慢慢发酵成&d虚空露水&r之类的特殊流体。"
		"备好对的材料，然后耐心等——发酵不是一瞬间的事。"
	]
	quest.6B37B24E3D25BF5C.quest_subtitle: "&7一路发酵，酿出虚空露水"
	quest.6B37B24E3D25BF5C.title: "&2&l酿液桶"
	quest.720A9D781C5B9B2D.quest_desc: [
		"&7&b基础电容库&r把&9µI&r存起来备用，相当于基地的一块电池。"
		"放进它格子里的工具和护甲也能充电。它用&a基础电容&r搭成。"
	]
	quest.720A9D781C5B9B2D.quest_subtitle: "&7我们的第一块电池"
	quest.720A9D781C5B9B2D.title: "&b&l基础电容库"
	quest.726857C4BE6ADCDE.quest_desc: [
		"&7只要还有电，&e飘浮权杖&r就能免掉摔落伤害，让我们轻飘飘地落地；每次生效会消耗经验。"
		"&a提示：&r爬高层建筑、在高空搭桥的时候，它能救命。"
	]
	quest.726857C4BE6ADCDE.quest_subtitle: "&7落得轻，跳得高"
	quest.726857C4BE6ADCDE.title: "&e&l飘浮权杖"
	quest.729B89CA30BE3B28.quest_desc: [
		"&7&e脉冲漏斗&r把附近的掉落物和经验球直接吸进自己的格子，等于给农场和刷怪塔配了台吸尘器。"
		"再接一条物品导管，它收到的东西就能直接进仓储系统。"
	]
	quest.729B89CA30BE3B28.quest_subtitle: "&7把地上的物品和经验都吸走"
	quest.729B89CA30BE3B28.title: "&e&l脉冲漏斗"
	quest.7717E30B48E53462.quest_desc: [
		"&7&2真空经验箱&r是可以随身带的升级件，我们走到哪，它就把附近的经验球直接吸进经验条。"
		"&2真空箱&r对掉落物做同样的事，把它们吸进自己的格子——大型刷怪塔的战利品再也不会漏掉。"
	]
	quest.7717E30B48E53462.quest_subtitle: "&7再也不落下战利品"
	quest.7717E30B48E53462.title: "&2&l真空经验箱&r &2与 &l真空箱"
	quest.79590DE87595F3C6.quest_desc: [
		"&7由&5魂金锭&r合成或粉碎而来。它用在少数只需要一点点这种材料的配方里。"
		"手边常备一组，就不用为了小配方去拆整锭了。"
	]
	quest.79590DE87595F3C6.quest_subtitle: "&7一小块被束缚的金"
	quest.79590DE87595F3C6.title: "&5&l魂金粒"
}
