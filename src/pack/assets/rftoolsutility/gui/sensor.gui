container {
    slot('ghost') {
        pos(154,24)
    }
    playerslots(10,70)
}

window {
    size(180,152)

    bind('type', 'type')
    bind('area', 'area')
    bind('group', 'group')
    bind('number', 'number')

    panel('','positional') {
        bg1('rftoolsutility:textures/gui/sensor.png')
        label('','类型:') {
            hint(10,3,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('area') {
            channel('area')
            hint(60,19,80,14)
            choices {
                choice('Area 1') {
                    tooltips('传感器前方1格')
                }
                choice('Area 3') {
                    tooltips('传感器前方3格')
                }
                choice('Area 5') {
                    tooltips('传感器前方 5 格')
                }
                choice('Area 3x3') {
                    tooltips('传感器前方的3x3方块')
                }
                choice('Area 5x5') {
                    tooltips('传感器前方的5x5方块区域')
                }
                choice('Area 7x7') {
                    tooltips('传感器前方 7x7 方块区域')
                }
            }
        }
        label('','区域:') {
            hint(10,19,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('type') {
            channel('type')
            hint(60,3,80,14)
            choices {
                choice('Block') {
                    tooltips('检测是否为某种类型','存在该方块')
                }
                choice('Fluid') {
                    tooltips('检测是否为某种类型','有流体存在')
                }
                choice('Growth') {
                    tooltips('检测生长百分比','作物的')
                }
                choice('Entities') {
                    tooltips('统计实体数量')
                }
                choice('Players') {
                    tooltips('统计玩家数量')
                }
                choice('Hostile') {
                    tooltips('统计敌对生物的数量')
                }
                choice('Passive') {
                    tooltips('统计被动型生物的数量')
                }
                choice('Items') {
                    tooltips('统计物品数量')
                }
            }
        }
        label('','分组:') {
            hint(10,35,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('group') {
            channel('group')
            hint(60,35,80,14)
            enableon('group')
            choices {
                choice('One') {
                    tooltips('已检测到至少一个','与传感器匹配')
                }
                choice('All') {
                    tooltips('区域内所有方块','必须与传感器匹配')
                }
            }
        }
        label('','数值：') {
            hint(10,51,50,14)
            horizalign('ALIGN_LEFT')
        }
        integerfield('number') {
            channel('number')
            hint(60,51,80,14)
            enableon('number')
            tooltips('设置该传感器类型对应的数值')
        }
    }
}
