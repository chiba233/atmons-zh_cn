    window {
        size(180,152)

        action('restart','restart')

        binddata('redstone','rsMode','mcjtylib:base_be_data')
        binddata('silent','silent','rftoolsbuilder:builder_data')
        binddata('entities','entityMode','rftoolsbuilder:builder_data')
        binddata('wait','waitMode','rftoolsbuilder:builder_data')
        binddata('loop','loopMode','rftoolsbuilder:builder_data')
        binddata('hilight','hilightMode','rftoolsbuilder:builder_data')
        binddata('support','supportMode','rftoolsbuilder:builder_data')
        binddata('mode','mode', 'rftoolsbuilder:builder_data')
        binddata('rotate','rotate', 'rftoolsbuilder:builder_data')

        panel('','positional') {
            bg1('rftoolsbuilder:textures/gui/builder.png')
            energybar('energybar') {
                hint(10,6,8,59)
                showtext(false)
            }
            panel('','positional') {
                hint(19,6,61,59)
                bgthickness(-2)
                bgfilled1(-7631989)
                choicelabel('mode') {
                    channel('mode')
                    hint(9,4,42,14)
                    enableon('validcard')
                    tooltips('设置建造模式')
                    choices {
                        choice('Copy') {
                            tooltips('从空间腔复制到此处','上方或下方放置装材料的箱子')
                        }
                        choice('Move') {
                            tooltips('从空间腔移动到此处')
                        }
                        choice('Swap') {
                            tooltips('将空间腔内容与此处交换')
                        }
                        choice('Back') {
                            tooltips('从此处移回空间腔')
                        }
                        choice('Collect') {
                            tooltips('收集空间腔中的物品','物品会进入上方或下方的箱子')
                        }
                    }
                }
            imagechoicelabel('silent') {
                channel('silent')
                hint(4,18,17,17)
                tooltips('抑制放置/破坏声音','（移动方块时）')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(176,48,256,256)
                choices {
                    choice('off') {
                        uv(176,48)
                        tooltips('移动方块时有声音')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(160,48)
                        tooltips('方块声音已静音')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('support') {
                channel('support')
                hint(22,18,17,17)
                tooltips('移动时使用支撑方块。','对液体、沙砾等很有用')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(112,48,256,256)
                choices {
                    choice('off') {
                        uv(112,48)
                        tooltips('支撑/预览模式已禁用')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(96,48)
                        tooltips('支撑/预览模式已启用')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('entities') {
                channel('entities')
                hint(4,37,17,17)
                tooltips('移动实体')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(144,48,256,256)
                choices {
                    choice('off') {
                        uv(144,48)
                        tooltips('不移动实体')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(128,48)
                        tooltips('实体会被移动')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('loop') {
                channel('loop')
                hint(22,37,17,17)
                tooltips('循环模式')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(208,48,256,256)
                choices {
                    choice('off') {
                        uv(208,48)
                        tooltips('运行一次后停止')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(192,48)
                        tooltips('有红石信号时持续运行')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('wait') {
                hint(40,18,17,17)
                tooltips('等待模式')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(96,80,256,256)
                choices {
                    choice('off') {
                        uv(112,80)
                        tooltips('若操作不可行','则不在该位置等待')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(96,80)
                        tooltips('若操作不可行','则在当前位置等待')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('hilight') {
                channel('hilight')
                hint(40,37,17,17)
                tooltips('高亮模式')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(144,80,256,256)
                choices {
                    choice('off') {
                        uv(144,80)
                        tooltips('不高亮')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(128,80)
                        tooltips('高亮显示建造机','当前正在处理的位置')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
        }
        panel('','positional') {
            hint(128,6,44,59)
            bgthickness(-2)
            bgfilled1(-7631989)
            choicelabel('rotate') {
                channel('rotate')
                hint(4,4,36,14)
                enableon('validcard')
                tooltips('设置水平旋转角度')
                choices {
                    choice('0')
                    choice('90')
                    choice('180')
                    choice('270')
                }
            }
            imagechoicelabel('anchor0') {
                channel('anchor')
                hint(4,37,17,17)
                tooltips('设置锚点：决定方块','放置在建造机前方的','哪个位置')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(96,64,256,256)
                choices {
                    choice('off') {
                        uv(112,64)
                        tooltips('建造机位于西南角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(96,64)
                        tooltips('建造机位于西南角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('anchor1') {
                channel('anchor')
                hint(23,37,17,17)
                tooltips('设置锚点：决定方块','放置在建造机前方的','哪个位置')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(144,64,256,256)
                choices {
                    choice('off') {
                        uv(144,64)
                        tooltips('建造机位于东南角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(128,64)
                        tooltips('建造机位于东南角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('anchor2') {
                channel('anchor')
                hint(4,18,17,17)
                tooltips('设置锚点：决定方块','放置在建造机前方的','哪个位置')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(176,64,256,256)
                choices {
                    choice('off') {
                        uv(176,64)
                        tooltips('建造机位于西北角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(160,64)
                        tooltips('建造机位于西北角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
            imagechoicelabel('anchor3') {
                channel('anchor')
                hint(23,18,17,17)
                tooltips('设置锚点：决定方块','放置在建造机前方的','哪个位置')
                border(true)
                image('rftoolsbase:textures/gui/guielements.png')
                dim(208,64,256,256)
                choices {
                    choice('off') {
                        uv(208,64)
                        tooltips('建造机位于东北角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                    choice('on') {
                        uv(192,64)
                        tooltips('建造机位于东北角')
                        image('rftoolsbase:textures/gui/guielements.png')
                    }
                }
            }
        }
        button('','?') {
            channel('cardgui')
            hint(83,12,13,12)
            tooltips('点击打开卡片界面')
        }
        button('level','Y: stop') {
            channel('restart')
            hint(81,31,45,13)
            tooltips('建造机当前所在层','§e按下以重启！')
        }
        imagechoicelabel('redstone') {
            hint(106,46,16,16)
            image('rftoolsbase:textures/gui/guielements.png')
            dim(32,0,256,256)
            choices {
                choice('Ignored') {
                    uv(0,0)
                    tooltips('红石模式：','忽略红石')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
                choice('Off') {
                    uv(16,0)
                    tooltips('红石模式：','无信号时激活')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
                choice('On') {
                    uv(32,0)
                    tooltips('红石模式：','有信号时激活')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
            }
        }
    }
}
