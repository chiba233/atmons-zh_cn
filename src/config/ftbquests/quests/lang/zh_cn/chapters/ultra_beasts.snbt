{
	quest.1E6F000000001199.quest_desc: ["&5究极虫洞&r会毫无预兆地在&8彼岸&r撕开，那是通往究极异兽故乡——异世界的门。\\n\\n大约每小时会成型一个虫洞，一只究极异兽会以强化过的高等级 Boss 姿态踏出来。把它磨到没血，再赶在裂口合上之前收服。这里没有祠堂，也没有召唤道具——天裂开的时候你人得在场。用&d究极球&r成功率最高。"]
	quest.1E6F000000001199.title: "&5究极虫洞"
	quest.1E6F00000000119C.quest_desc: ["&f虚吾伊德&r是像水母一样漂浮的究极异兽，据说是一种寄生生物，会附上宿主，用毒液扭曲它的心智。\\n\\n盯着彼岸的究极虫洞，等它出来时把它放倒。"]
	quest.1E6F00000000119C.quest_subtitle: "阿罗拉"
	quest.1E6F00000000119C.title: "虚吾伊德"
	quest.1E6F0000000011A0.quest_desc: ["&c爆肌蚊&r是膨胀宝可梦，一只由怪诞肌肉堆成的究极异兽，动不动就摆出把地面震裂的姿势炫耀那身鼓胀的躯体。\\n\\n等它硬闯出究极虫洞时收服它。"]
	quest.1E6F0000000011A0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A0.title: "爆肌蚊"
	quest.1E6F0000000011A4.quest_desc: ["&f费洛美螂&r是柔软宝可梦，一只速度与身姿都极致的究极异兽，绝不容许任何脏东西碰到自己。\\n\\n趁它还没溜走，在究极虫洞旁把它追下来。"]
	quest.1E6F0000000011A4.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A4.title: "费洛美螂"
	quest.1E6F0000000011A8.quest_desc: ["&e电束木&r是发光宝可梦，一只像一团活电缆缠成的究极异兽，会抽干整片电网来喂饱自己那具带电的身体。\\n\\n等它从究极虫洞里涌出来时把它收服。"]
	quest.1E6F0000000011A8.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A8.title: "电束木"
	quest.1E6F0000000011AC.quest_desc: ["&a铁火辉夜&r是发射宝可梦，一只形似火箭的巨型究极异兽，据说升空时会把周围的森林烧成焦土。\\n\\n在彼岸的究极虫洞旁把它放倒。"]
	quest.1E6F0000000011AC.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011AC.title: "铁火辉夜"
	quest.1E6F0000000011B0.quest_desc: ["&2纸御剑&r是拔刀宝可梦，一只折叠得像折纸的究极异兽，却锋利到一刀能把钢塔劈开。\\n\\n等它从究极虫洞里切出来时收服它。"]
	quest.1E6F0000000011B0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B0.title: "纸御剑"
	quest.1E6F0000000011B4.quest_desc: ["&8恶食大王&r是暴食宝可梦，一只体型庞大的究极异兽，什么都吞——建筑、山脉、海洋——却好像永远填不满。\\n\\n在究极虫洞旁面对这位饕餮，把它收服。"]
	quest.1E6F0000000011B4.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B4.title: "恶食大王"
	quest.1E6F0000000011B8.quest_desc: ["&7垒磊石&r是壁垒宝可梦，一只看上去像好几只生物叠成高墙、被唤醒后动了起来的究极异兽。\\n\\n在究极虫洞旁把它推倒，收进队伍。"]
	quest.1E6F0000000011B8.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B8.title: "垒磊石"
	quest.1E6F0000000011BC.quest_desc: ["&d砰头小丑&r是烟花宝可梦，一只究极异兽，先用炫目的表演把人引到近前，再引爆自己的脑袋把他们轰散。\\n\\n等它从究极虫洞里炸出来时收服它。"]
	quest.1E6F0000000011BC.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011BC.title: "砰头小丑"
	quest.1E6F0000000011C0.quest_desc: ["&5毒贝比&r是毒针宝可梦，一只罕见又出奇黏人的究极异兽，一兴奋就会射出带毒的尖刺。\\n\\n在究极虫洞旁把它收服——把亲密度养够，它会进化成凶恶的&5四颚针龙&r。"]
	quest.1E6F0000000011C0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011C0.title: "毒贝比"
	task.1E6F00000000119D.title: "收服虚吾伊德"
	task.1E6F0000000011A1.title: "收服爆肌蚊"
	task.1E6F0000000011A5.title: "收服费洛美螂"
	task.1E6F0000000011A9.title: "收服电束木"
	task.1E6F0000000011AD.title: "收服铁火辉夜"
	task.1E6F0000000011B1.title: "收服纸御剑"
	task.1E6F0000000011B5.title: "收服恶食大王"
	task.1E6F0000000011B9.title: "收服垒磊石"
	task.1E6F0000000011BD.title: "收服砰头小丑"
	task.1E6F0000000011C1.title: "收服毒贝比"
}
